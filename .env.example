# ============================================================================
# CAMPUSFIND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# IMPORTANT SECURITY RULE:
# Never commit real AWS secret access keys, database passwords, or private
# tokens to GitHub or expose them in VITE_* frontend variables.

# Runtime Environment (development | production)
NODE_ENV="development"
PORT="3000"

# Application Base URL (Automatically injected in hosted runtime)
APP_URL="http://localhost:3000"

# Optional AWS Amplify / Cognito / AppSync Public Client Identifiers
# (Populate after running `npx ampx sandbox` or deploying via AWS Amplify Console)
VITE_AWS_REGION="ap-south-1"
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_USER_POOL_CLIENT_ID=""
VITE_APPSYNC_GRAPHQL_ENDPOINT=""
